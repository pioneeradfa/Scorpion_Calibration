+        Z_roll_change = math.cos(phi) * ex - Leg.Z_Coordinate
+        Leg.Y_Coordinate = Leg.Y_Coordinate + Y_roll_change
+        Leg.Z_Coordinate = Leg.Z_Coordinate + Z_roll_change
